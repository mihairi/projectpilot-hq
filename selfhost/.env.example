# Copy to selfhost/.env and edit. Never commit the filled-in file.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5432

# --- URLs ---
# Where the API gateway is reachable from browsers (LAN name or IP, not "localhost",
# if other machines must reach it).
PUBLIC_URL=http://localhost:8000
GATEWAY_PORT=8000
# Where the web app itself is served.
APP_URL=http://localhost:3000

# --- Signing key ---
# Minimum 32 characters. Generate with: bun run selfhost/scripts/gen-keys.mjs
JWT_SECRET=change-me-32-characters-minimum-secret

# --- Microsoft Exchange Online (SMTP AUTH submission) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=projectportal@yourcompany.com
SMTP_PASS=app-or-mailbox-password
SMTP_FROM=projectportal@yourcompany.com
SMTP_FROM_NAME=Project Portal

# --- Notification mailer (selfhost/scripts/notify.mjs) ---
# Host/port of the database as seen from where the mailer runs.
POSTGRES_HOST=localhost
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# How many days ahead counts as "deadline approaching".
NOTIFY_DEADLINE_DAYS=3
# Max notifications emailed per run (Exchange throttles ~30 msgs/minute).
NOTIFY_BATCH_SIZE=200
# Set to 1 to print instead of sending.
NOTIFY_DRY_RUN=
